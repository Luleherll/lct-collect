---
import '../styles/app.css';
interface Props { title?: string }
const { title = 'LCT Collect' } = Astro.props;
---
<!doctype html><html lang="en-UG"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="theme-color" content="#192e49"/><meta name="description" content="Lusaze Community Traders SACCO field collection log"/><link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png"/><link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png"/><link rel="manifest" href="/manifest.webmanifest"/><title>{title}</title></head><body><a class="skip-link" href="#main-content">Skip to content</a><slot/><noscript><p>LCT Collect requires JavaScript to sign in and view records.</p></noscript><script>if('serviceWorker' in navigator && import.meta.env.PROD) navigator.serviceWorker.register('/sw.js').catch(()=>{/* The online app remains usable if app-shell caching is unavailable. */});</script></body></html>
