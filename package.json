{
  "name": "lct-collect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-env.mjs && astro build && node scripts/build-sw.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run --exclude tests/firestore.rules.test.ts --exclude 'tests/e2e/**'",
    "test:rules": "firebase emulators:exec --only firestore --project demo-lct-collect 'vitest run tests/firestore.rules.test.ts'",
    "test:ci": "npm run test && npm run test:rules && npm run test:smoke",
    "profile:user": "tsx scripts/profile-user.ts",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-lct-collect",
    "seed:emulators": "tsx scripts/seed-emulators.ts",
    "dev:emulators": "PUBLIC_USE_EMULATORS=true astro dev",
    "test:smoke": "firebase emulators:exec --only auth,firestore --project demo-lct-collect \"npm run seed:emulators && tsx scripts/smoke-emulators.ts\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-lct-collect \"LCT_SEED_MEMBERS=820 node --import tsx scripts/seed-emulators.ts && playwright test\"",
    "test:e2e:running": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.{ts,mjs}\" \"tests/**/*.ts\" \"*.{json,md,ts,mjs}\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.{ts,mjs}\" \"tests/**/*.ts\" \"*.{json,md,ts,mjs}\" \".github/workflows/*.yml\""
  },
  "dependencies": {
    "@astrojs/react": "^4.3.0",
    "astro": "^5.13.10",
    "firebase": "^12.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "firebase-admin": "^13.5.0",
    "firebase-tools": "^14.17.0",
    "prettier": "3.9.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "yaml": "^2.9.1"
  }
}
